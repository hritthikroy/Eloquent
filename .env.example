# ============================================
# ELOQUENT CONFIGURATION TEMPLATE
# ============================================
# Copy this file to .env and fill in your values
# Get free Groq API key at: https://console.groq.com/

# ============================================
# GROQ API KEY (REQUIRED FOR AI FEATURES)
# ============================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_1=your_groq_api_key_here
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

# ============================================
# BACKEND API (OPTIONAL)
# ============================================
ELOQUENT_API_URL=https://agile-basin-06335-9109082620ce.herokuapp.com

# ============================================
# SUPABASE CONFIGURATION (OPTIONAL)
# ============================================
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# ============================================
# OAUTH REDIRECT (OPTIONAL)
# ============================================
OAUTH_REDIRECT_URL=https://agile-basin-06335-9109082620ce.herokuapp.com/auth/success

# ============================================
# APP SETTINGS
# ============================================
LANGUAGE=en
AI_MODE=qn
AUTO_GRAMMAR_FIX=true
PRESERVE_CLIPBOARD=false

# ============================================
# DEVELOPMENT/TESTING
# ============================================
FORCE_DEV_MODE=false
FORCE_QUICK_SIGNIN=false
ADMIN_EMAIL=your_email@example.com
