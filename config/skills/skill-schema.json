{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentSkillProfile",
  "description": "Strict JSON schema for Eloquent agent skill profiles, skill definitions, and metadata array mutations",
  "type": "object",
  "required": [
    "agentId",
    "name",
    "role",
    "version",
    "enabled",
    "skills",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "agentId": {
      "type": "string",
      "pattern": "^agent_[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "enabled": {
      "type": "boolean"
    },
    "lastUpdated": {
      "type": "integer"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "handler", "category", "timeoutMs", "enabled"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "handler": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": ["engineering", "automation", "audio-ipc", "system", "general"]
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 100
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "metadata": {
      "type": "array",
      "description": "Array of typed metadata key-value configurations for the agent",
      "items": {
        "type": "object",
        "required": ["key", "value", "type"],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "value": {},
          "type": {
            "type": "string",
            "enum": ["string", "number", "boolean", "object", "array"]
          },
          "description": {
            "type": "string"
          },
          "timestamp": {
            "type": "integer"
          }
        }
      }
    }
  }
}
